ssName = theme;\r\n    document.body.style.transition = 'background-image 0.5s';\r\n\r\n    // Save theme to localStorage\r\n    localStorage.setItem('theme', theme);\r\n    }, [theme]);\r\n\r\n  const toggleTheme = () => {\r\n    setTheme((prevTheme) => (prevTheme === 'light' ? 'dark' : 'light'));\r\n  };\r\n\r\n    return (\r\n        <header>\r\n            <h2 className='name'><Link to=\"/\">_nicrhoda_</Link></h2>\r\n            <Button className='darkMode' size='sm' variant={theme === 'light' ? 'outline-dark' : 'outline-light'} onClick={() => {toggleTheme(); toggleBackground();}}>{theme ==='light' ? 'Light Mode' : 'Dark Mode'}</Button>\r\n            <div className='navBarComp'><Navbar /></div>\r\n        </header>\r\n    ) \r\n}","C:\\Users\\Nic\\coding\\nicrhoda_portfolio\\src\\components\\Projects.js",[],"C:\\Users\\Nic\\coding\\nicrhoda_portfolio\\src\\components\\Footer.js",[],"C:\\Users\\Nic\\coding\\nicrhoda_portfolio\\src\\components\\Contact\\Contact.js",[],"C:\\Users\\Nic\\coding\\nicrhoda_portfolio\\src\\components\\Resume.js",[],"C:\\Users\\Nic\\coding\\nicrhoda_portfolio\\src\\components\\Navbar\\Navbar.js",[],{"ruleId":"43","replacedBy":"44"},{"ruleId":"45","replacedBy":"46"},{"ruleId":"47","severity":1,"message":"48","line":15,"column":15,"nodeType":"49","messageId":"50","endLine":15,"endColumn":23},"no-native-reassign",["51"],"no-negated-in-lhs",["52"],"no-unused-vars","'newImage' is assigned a value but never used.","Identifier","unusedVar","no-global-assign","no-unsafe-negation"]